*.rej
*~
*.swp

# ===============================================
# Archivos Específicos del Proyecto
# ===============================================

# Archivos de prueba temporales
test-data/
mock-data/
seed-data/

# Archivos de migración generados automáticamente
migrations/generated/

# Archivos de configuración local personalizados
config.local.js
settings.local.json

# ===============================================
# Variables de Entorno de Ejemplo (MANTENER)
# ===============================================
# NOTA: .env.example SÍ debe estar en el repo
# !.env.example

# ===============================================
# Archivos que SÍ deben incluirse (usando !)
# ===============================================
!.env.example
!.gitkeep
!README.md
!LICENSE
!package.json
!package-lock.json

# ===============================================
# Comentarios y Notas
# ===============================================

# IMPORTANTE: 
# - NUNCA subir archivos .env con credenciales reales
# - Mantener .env.example como template
# - Revisar este .gitignore antes de cada commit
# - Usar 'git status' para verificar qué se está subiendo

# COMANDOS ÚTILES:
# git rm --cached .env          # Remover .env del tracking si ya fue agregado
# git check-ignore archivo      # Verificar si un archivo está siendo ignorado
# git status --ignored          # Ver archivos ignorados