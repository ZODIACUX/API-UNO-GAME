# ===============================================
# Node.js Dependencies
# ===============================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ===============================================
# Environment Variables (CRÍTICO - NO SUBIR)
# ===============================================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local

# Backup de archivos .env
.env.backup
.env.bak
*.env

# ===============================================
# Logs y Archivos Temporales
# ===============================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

