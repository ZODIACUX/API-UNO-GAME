	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Verificar configuración",
					"console.log('🔍 Base URL:', pm.collectionVariables.get('baseUrl'));",
					"console.log('🔍 API URL:', pm.collectionVariables.get('apiUrl'));",
					"",
					"// Verificar token si es necesario",
					"if (pm.request.headers && pm.request.headers.get('Authorization')) {",
					"    const token = pm.collectionVariables.get('accessToken');",
					"    if (!token) {",
					"        console.log('⚠️ Token no configurado. Ejecuta Login primero.');",
					"    }",
					"}"
				]
			}
		},
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Log para todas las respuestas",
					"const status = pm.response.status;",
					"const time = pm.response.responseTime;",
					"const name = pm.info.requestName;",
					"",
					"if (status >= 200 && status < 300) {",
					"    console.log(`✅ ${name}: ${status} (${time}ms)`);",
					"} else if (status >= 400) {",
					"    console.log(`❌ ${name}: ${status} (${time}ms)`);",
					"    try {",
					"        const body = pm.response.json();",
					"        if (body.message) {",
					"            console.log('   Error:', body.message);",
					"        }",
					"    } catch (e) {",
					"        console.log('   Error parsing response');",
					"    }",
					"} else {",
					"    console.log(`ℹ️ ${name}: ${status} (${time}ms)`);",
					"}",
					"",
					"// Test global de tiempo de respuesta",
					"pm.test('Response time under 5s', function () {",
					"    pm.expect(pm.response.responseTime).to.be.below(5000);",
					"});"
				]
			}
		}
