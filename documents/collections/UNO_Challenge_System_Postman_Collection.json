{
  "info": {
    "name": "UNO Challenge System API",
    "description": "Complete collection for testing UNO Challenge System (Requirement 5) and UNO Call System (Requirement 4)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "1.0.0"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000/api",
      "type": "string"
    },
    {
      "key": "access_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "game_id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Register User 1 (Challenger)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"challenger1\",\n  \"email\": \"challenger1@test.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/register",
              "host": ["{{base_url}}"],
              "path": ["register"]
            }
          }
        },
        {
          "name": "Register User 2 (Challenged)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"challenged1\",\n  \"email\": \"challenged1@test.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/register",
              "host": ["{{base_url}}"],
              "path": ["register"]
            }
          }
        },
        {
          "name": "Login User 1 (Challenger)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    pm.collectionVariables.set('access_token', response.access_token);",
                  "    console.log('Token saved:', response.access_token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"challenger1\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/login",
              "host": ["{{base_url}}"],
              "path": ["login"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Game Setup",
      "item": [
        {
          "name": "Create Game",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const response = pm.response.json();",
                  "    pm.collectionVariables.set('game_id', response.game_id);",
                  "    console.log('Game ID saved:', response.game_id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"UNO Challenge Test Game\",\n  \"rules\": \"Standard UNO rules with challenge system\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/game/create",
              "host": ["{{base_url}}"],
              "path": ["game", "create"]
            }
          }
        },
        {
          "name": "Join Game (User 2)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"game_id\": {{game_id}}\n}"
            },
            "url": {
              "raw": "{{base_url}}/game/join",
              "host": ["{{base_url}}"],
              "path": ["game", "join"]
            }
          }
        },
        {
          "name": "Start Game",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"game_id\": {{game_id}}\n}"
            },
            "url": {
              "raw": "{{base_url}}/game/start",
              "host": ["{{base_url}}"],
              "path": ["game", "start"]
            }
          }
        }
      ]
    },
    {
      "name": "3. UNO Call System (Requirement 4)",
      "item": [
        {
          "name": "Call UNO - Valid",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"player\": \"challenged1\",\n  \"action\": \"Say UNO\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/uno/call",
              "host": ["{{base_url}}"],
              "path": ["uno", "call"]
            }
          }
        },
        {
          "name": "Call UNO - Invalid Action",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"player\": \"challenged1\",\n  \"action\": \"Invalid Action\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/uno/call",
              "host": ["{{base_url}}"],
              "path": ["uno", "call"]
            }
          }
        },
        {
          "name": "Call UNO - Missing Player",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"Say UNO\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/uno/call",
              "host": ["{{base_url}}"],
              "path": ["uno", "call"]
            }
          }
        }
      ]
    },
    {
      "name": "4. UNO Challenge System (Requirement 5)",
      "item": [
        {
          "name": "Challenge UNO - Valid Challenge",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"challenger\": \"challenger1\",\n  \"challengedPlayer\": \"challenged1\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/uno/challenge",
              "host": ["{{base_url}}"],
              "path": ["uno", "challenge"]
            }
          }
        },
        {
          "name": "Challenge UNO - Self Challenge (Invalid)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"challenger\": \"challenger1\",\n  \"challengedPlayer\": \"challenger1\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/uno/challenge",
              "host": ["{{base_url}}"],
              "path": ["uno", "challenge"]
            }
          }
        },
        {
          "name": "Challenge UNO - Missing Challenger",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"challengedPlayer\": \"challenged1\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/uno/challenge",
              "host": ["{{base_url}}"],
              "path": ["uno", "challenge"]
            }
          }
        },
        {
          "name": "Challenge UNO - Missing Challenged Player",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"challenger\": \"challenger1\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/uno/challenge",
              "host": ["{{base_url}}"],
              "path": ["uno", "challenge"]
            }
          }
        },
        {
          "name": "Challenge UNO - Empty Challenger",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"challenger\": \"\",\n  \"challengedPlayer\": \"challenged1\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/uno/challenge",
              "host": ["{{base_url}}"],
              "path": ["uno", "challenge"]
            }
          }
        },
        {
          "name": "Challenge UNO - Empty Body",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": {
              "raw": "{{base_url}}/uno/challenge",
              "host": ["{{base_url}}"],
              "path": ["uno", "challenge"]
            }
          }
        }
      ]
    },
    {
      "name": "5. Game State Queries",
      "item": [
        {
          "name": "Get Game State",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"game_id\": {{game_id}}\n}"
            },
            "url": {
              "raw": "{{base_url}}/game/state",
              "host": ["{{base_url}}"],
              "path": ["game", "state"]
            }
          }
        },
        {
          "name": "Get Game Players",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"game_id\": {{game_id}}\n}"
            },
            "url": {
              "raw": "{{base_url}}/game/players",
              "host": ["{{base_url}}"],
              "path": ["game", "players"]
            }
          }
        },
        {
          "name": "Get Current Player",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"game_id\": {{game_id}}\n}"
            },
            "url": {
              "raw": "{{base_url}}/game/current-player",
              "host": ["{{base_url}}"],
              "path": ["game", "current-player"]
            }
          }
        }
      ]
    },
    {
      "name": "6. Card Operations",
      "item": [
        {
          "name": "Deal Cards",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"players\": [\"challenger1\", \"challenged1\"],\n  \"cardsPerPlayer\": 7\n}"
            },
            "url": {
              "raw": "{{base_url}}/cards/deal",
              "host": ["{{base_url}}"],
              "path": ["cards", "deal"]
            }
          }
        },
        {
          "name": "Play Card",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"player\": \"challenger1\",\n  \"cardPlayed\": \"Red 5\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/cards/play",
              "host": ["{{base_url}}"],
              "path": ["cards", "play"]
            }
          }
        },
        {
          "name": "Draw Card",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"player\": \"challenged1\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/cards/draw",
              "host": ["{{base_url}}"],
              "path": ["cards", "draw"]
            }
          }
        }
      ]
    }
  ]
}