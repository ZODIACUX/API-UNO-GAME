	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Verificar variables antes de cada request",
					"if (pm.request.url.path && pm.request.url.path.includes('{{gameId}}')) {",
					"    const gameId = pm.collectionVariables.get('gameId');",
					"    if (!gameId) {",
					"        console.log('⚠️ Game ID no está configurado. Ejecuta \"Create Game\" primero.');",
					"    }",
					"}",
					"",
					"if (pm.request.headers && pm.request.headers.get('Authorization')) {",
					"    const token = pm.collectionVariables.get('accessToken');",
					"    if (!token) {",
					"        console.log('⚠️ Access Token no está configurado. Ejecuta \"Login User\" primero.');",
					"    }",
					"}"
				]
			}
		},
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Tests globales para todas las respuestas",
					"pm.test('Response time is less than 5000ms', function () {",
					"    pm.expect(pm.response.responseTime).to.be.below(5000);",
					"});",
					"",
					"pm.test('Response has JSON body', function () {",
					"    pm.response.to.have.jsonBody();",
					"});",
					"",
					"// Log de información útil",
					"console.log(`${pm.info.requestName}: ${pm.response.status} (${pm.response.responseTime}ms)`);"
				]
			}
		}
	],
