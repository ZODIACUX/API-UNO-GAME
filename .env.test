# .env.test - Configuración para entorno de testing

# Configuración de entorno
NODE_ENV=test
PORT=3001
LOG_LEVEL=error

# Base de datos de test
DB_HOST=localhost
DB_PORT=3319
DB_USERNAME=gameuser
DB_PASSWORD=gamepassword
DB_NAME=game_management_test

# JWT y seguridad
JWT_SECRET=jPxWnlweA9ri7Z2B2X1B3DSd2r5RYYRm
BCRYPT_ROUNDS=10

# Rate limiting (más permisivo para tests)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# Configuración específica para tests
TEST_DB_DROP_BEFORE_SYNC=true
TEST_TIMEOUT=30000
TEST_PARALLEL=false

# CORS para tests
CORS_ORIGIN=http://localhost:3001

# Configuración de logs
LOG_FILE=tests.log